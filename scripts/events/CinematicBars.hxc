import funkin.modding.module.ModuleHandler;
import funkin.play.event.SongEvent;

class CinematicBars extends SongEvent
{

	public function getEventSchema() {
		return [
			{
				name: "ratio",
				title: "Aspect Ratio",
				defaultValue: 0,
				type: "enum",
				keys: [
					"21:9" => 0,
					"4:3" => 1
				]
			},
			{
				name: "duration",
				title: "Duration",
				defaultValue: 4.0,
				step: 0.5,
				type: "float",
				units: "steps"
			},
			{
				name: "enable",
				title: "Enable / Disable Bars",
				defaultValue: true,
				type: "bool"
			}
		];
	}

	public function getTitle() { // Event name
		return "Cinematic Bars";
	}

	public function new() {
		super('CinematicBars');
	}

	override function handleEvent(data)
	{
		ModuleHandler.getModule("BlackBars").scriptCall("tweenBars", [data.getInt("ratio"), data.getFloat("duration"), data.getBool("enable")]);	
	}

	override function onDestroy(event)
	{
		topBar = null;
		super.onDestroy(event);
	}
}